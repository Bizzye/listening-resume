{
	"name": "listening-resume",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"listen": "pnpm --filter @listening-resume/cli exec tsx src/index.ts",
		"test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
		"test:unit": "pnpm --filter @listening-resume/core test:unit && pnpm --filter @listening-resume/gui test:unit && pnpm test:rust",
		"test:integration": "pnpm --filter @listening-resume/core test:integration && pnpm --filter @listening-resume/gui test:integration",
		"test:e2e": "pnpm --filter @listening-resume/cli test:e2e && pnpm --filter @listening-resume/gui test:e2e",
		"test:watch": "pnpm --filter @listening-resume/core test:watch",
		"build": "pnpm -r build",
		"dev": "pnpm --filter @listening-resume/gui dev",
		"build:windows": "pnpm --filter @listening-resume/gui build:windows",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"test:rust": "cargo test --manifest-path apps/gui/src-tauri/Cargo.toml --bin wasapi-capture",
		"test:hardware": "pnpm --filter @listening-resume/gui exec playwright test --grep @hardware",
		"screenshots": "pnpm --filter @listening-resume/gui exec playwright test --grep @screens"
	},
	"description": "Record system audio, transcribe and summarize meetings",
	"type": "module",
	"devDependencies": {
		"esbuild": "^0.28.0"
	}
}
