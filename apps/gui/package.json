{
	"name": "@listening-resume/gui",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k \"vite\" \"node --import tsx --watch --watch-path=server.ts --watch-path=server --watch-path=../../packages/core/dist server.ts\"",
		"dev:ui": "vite",
		"dev:server": "node --import tsx --watch --watch-path=server.ts --watch-path=server --watch-path=../../packages/core/dist server.ts",
		"build": "vite build",
		"build:server": "node scripts/build-server.mjs",
		"smoke:server": "node scripts/smoke-test-server.mjs",
		"build:tauri": "pnpm build && pnpm build:server && pnpm tauri build",
		"build:linux": "pnpm --filter core build && pnpm build && pnpm build:server && pnpm smoke:server && pnpm tauri build && pnpm collect:installers",
		"install:linux": "pnpm build:linux && sudo dpkg -i src-tauri/target/release/bundle/deb/*.deb",
		"build:wasapi": "pwsh -ExecutionPolicy Bypass -File src-tauri/scripts/build-wasapi.ps1",
		"build:windows": "pnpm --filter @listening-resume/core build && pnpm build && pnpm build:server && pwsh -ExecutionPolicy Bypass -File src-tauri/scripts/download-deps-win.ps1 && pnpm build:wasapi && pnpm smoke:server && pnpm tauri build && pnpm collect:installers",
		"preview": "vite preview",
		"tauri": "tauri",
		"test": "vitest run",
		"test:unit": "vitest run tests/ui tests/server/unit",
		"test:integration": "vitest run tests/server/integration",
		"test:e2e": "playwright test",
		"lint": "biome check .",
		"format": "biome format . --write",
		"collect:installers": "node scripts/collect-installers.mjs"
	},
	"dependencies": {
		"@fontsource/geist": "5.3.0",
		"@fontsource/geist-mono": "5.3.0",
		"@listening-resume/core": "workspace:*",
		"docx": "^9.9.0",
		"pdf-lib": "^1.17.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-markdown": "^9.0.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@playwright/test": "^1.64.0",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/cli": "^2.11.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"concurrently": "^9.0.0",
		"jsdom": "^30.1.2",
		"tsx": "^4.0.0",
		"typescript": "^5.5.0",
		"vite": "^6.0.0",
		"vitest": "^4.1.7"
	}
}
